routine: GETBOOKSCOUNT
  specific name: GETBOOKSCOUNT_10158
  return type: no result
  body type: sql
  definition:
CREATE PROCEDURE BOOKS.GETBOOKSCOUNT(OUT BOOKSCOUNT INTEGER) SPECIFIC GETBOOKSCOUNT_10158 LANGUAGE SQL NOT DETERMINISTIC READS SQL DATA NEW SAVEPOINT LEVEL BEGIN ATOMIC SELECT COUNT(*)INTO BOOKSCOUNT FROM BOOKS.BOOKS;END

routine: NEW_PUBLISHER
  specific name: NEW_PUBLISHER_10154
  return type: no result
  body type: sql
  definition:
CREATE PROCEDURE BOOKS.NEW_PUBLISHER(IN NEWPUBLISHER VARCHAR(50),OUT PUBLISHER VARCHAR(50)) SPECIFIC NEW_PUBLISHER_10154 LANGUAGE SQL NOT DETERMINISTIC CONTAINS SQL NEW SAVEPOINT LEVEL SET PUBLISHER = NEWPUBLISHER

routine: NEW_PUBLISHER
  specific name: NEW_PUBLISHER_FORCE_VALUE
  return type: no result
  body type: sql
  definition:
CREATE PROCEDURE BOOKS.NEW_PUBLISHER(OUT PUBLISHER VARCHAR(50)) SPECIFIC NEW_PUBLISHER_FORCE_VALUE LANGUAGE SQL NOT DETERMINISTIC CONTAINS SQL NEW SAVEPOINT LEVEL SET PUBLISHER = 'New Publisher'

routine: CUSTOMADD
  specific name: CUSTOMADD_10155
  return type: does not return a table
  body type: sql
  definition:
CREATE FUNCTION BOOKS.CUSTOMADD(IN ONE INTEGER,IN TWO INTEGER) RETURNS INTEGER SPECIFIC CUSTOMADD_10155 LANGUAGE SQL NOT DETERMINISTIC CONTAINS SQL CALLED ON NULL INPUT RETURN ONE+TWO

routine: CUSTOMADD
